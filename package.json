{
  "name": "magi",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "magi": "bun packages/cli/dist/index.js",
    "dev": "bun run --filter @magi/cli dev",
    "build": "bun run --filter @magi/core build && bun run --filter @magi/sandbox build && bun run --filter @magi/cli build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "bun run --filter '*' test",
    "ui:dev": "bun run --filter @magi/ui tauri:dev",
    "ui:build": "bun run --filter @magi/ui tauri:build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "latest",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.3",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.58.2",
    "yaml": "^2.8.3"
  }
}
